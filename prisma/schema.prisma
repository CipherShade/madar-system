generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
}

enum TenantPlan {
  FREE_TRIAL
  BASIC
  GROWTH
  PRO
  MULTI_BRANCH
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  VODAFONE_CASH
  INSTAPAY
}

enum AttendanceStatus {
  PAID
  PARTIAL
  EXCUSED
  VOID
}

enum SettlementStatus {
  PENDING
  DISBURSED
}

enum SchoolType {
  GENERAL
  LANGUAGES
  AZHAR
}

// 0. SaaS Tenant (Educational Center)
model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  ownerName             String?                @map("owner_name")
  ownerPhone            String?                @map("owner_phone")
  plan                  TenantPlan             @default(FREE_TRIAL)
  trialEndsAt           DateTime?              @map("trial_ends_at")
  isActive              Boolean                @default(true) @map("is_active")
  maxDesks              Int                    @default(1) @map("max_desks")
  maxBranches           Int                    @default(1) @map("max_branches")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  users                 User[]
  branches              Branch[]
  usageRecords          UsageRecord[]
  rooms                 Room[]
  teachers              Teacher[]
  students              Student[]
  sessions              Session[]
  shiftRegisters        ShiftRegister[]
  attendances           Attendance[]
  sessionReconciliations SessionReconciliation[]
  sessionSettlements    SessionSettlement[]
  expenses              Expense[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]

  @@map("tenants")
}

// 0.1 SaaS Subscriptions & Billing
model Subscription {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  plan                  TenantPlan
  status                SubscriptionStatus     @default(ACTIVE)
  amount                Decimal
  currency              String                 @default("EGP")
  paymentMethod         PaymentMethod?         @map("payment_method")
  paymentReference      String?                @map("payment_reference")
  periodStart           DateTime               @default(now()) @map("period_start")
  periodEnd             DateTime               @map("period_end")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// 0.2 SaaS Tenant Branches
model Branch {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  name                  String
  address               String?
  phoneNumber           String?                @map("phone_number")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecords          UsageRecord[]
  rooms                 Room[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// 0.3 Monthly Usage Records
model UsageRecord {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  branchId              String?                @map("branch_id")
  periodStart           DateTime               @map("period_start")
  periodEnd             DateTime               @map("period_end")
  visitCount            Int                    @default(0) @map("visit_count")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, periodStart, periodEnd])
  @@index([tenantId, periodStart, periodEnd])
  @@map("usage_records")
}

// 1. Center Staff Internal Accounts
model User {
  id                String          @id @default(uuid())
  tenantId          String?         @map("tenant_id")
  username          String          @unique
  email             String?         @unique
  passwordHash      String          @map("password_hash")
  fullName          String          @map("full_name")
  role              Role            @default(RECEPTIONIST)
  phoneNumber       String?         @map("phone_number")
  preferredLanguage String          @default("ar") @map("preferred_language")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegisters    ShiftRegister[]
  attendances       Attendance[]
  reconciliations   SessionReconciliation[]
  settlements       SessionSettlement[]
  expenses          Expense[]
  sessionsCreated   Session[]
  auditLogs         AuditLog[]

  @@index([tenantId])
  @@map("users")
}

// 2. Classrooms & Lecture Halls
model Room {
  id        String    @id @default(uuid())
  tenantId  String?   @map("tenant_id")
  branchId  String?   @map("branch_id")
  name      String
  capacity  Int
  floor     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions  Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([branchId])
  @@map("rooms")
}

// 3. Tutors / Instructors
model Teacher {
  id                String    @id @default(uuid())
  tenantId          String?   @map("tenant_id")
  fullName          String    @map("full_name")
  /// Normalized Arabic name for trigram search
  searchName        String    @map("search_name")
  phoneNumber       String    @map("phone_number")
  subject           String
  defaultCenterFee  Decimal   @map("default_center_fee")
  assistantName     String?   @map("assistant_name")
  assistantPhone    String?   @map("assistant_phone")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          Session[]

  @@index([tenantId, searchName])
  @@index([tenantId])
  @@map("teachers")
}

// 4. Student Master Directory
model Student {
  id            String        @id @default(uuid())
  tenantId      String?       @map("tenant_id")
  studentCode   String        @map("student_code")
  fullName      String        @map("full_name")
  /// Normalized Arabic name (Alef unified, taa marbouta, diacritics stripped) for trigram search
  searchName    String        @map("search_name")
  studentPhone  String?       @map("student_phone")
  guardianPhone String        @map("guardian_phone")
  academicStage String        @map("academic_stage")
  schoolType    SchoolType    @default(GENERAL) @map("school_type")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances   Attendance[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, searchName])
  @@index([tenantId, studentPhone])
  @@index([tenantId, guardianPhone])
  @@index([tenantId])
  @@map("students")
}

// 5. Scheduled Class Sessions
model Session {
  id                    String        @id @default(uuid())
  tenantId              String?       @map("tenant_id")
  teacherId             String        @map("teacher_id")
  roomId                String        @map("room_id")
  title                 String
  academicStage         String        @map("academic_stage")
  startTime             DateTime      @map("start_time")
  endTime               DateTime      @map("end_time")
  sessionPrice          Decimal       @map("session_price")
  centerFeePerStudent   Decimal       @map("center_fee_per_student")
  status                SessionStatus @default(SCHEDULED)
  createdById           String        @map("created_by")
  createdAt             DateTime      @default(now()) @map("created_at")

  tenant                Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher               Teacher       @relation(fields: [teacherId], references: [id])
  room                  Room          @relation(fields: [roomId], references: [id])
  createdBy             User          @relation(fields: [createdById], references: [id])

  attendances           Attendance[]
  reconciliation        SessionReconciliation?
  settlement            SessionSettlement?

  @@index([tenantId, status, startTime, endTime])
  @@index([tenantId])
  @@index([teacherId])
  @@index([roomId])
  @@map("sessions")
}

// 6. Per-Desk Shift Cash Drawers
model ShiftRegister {
  id                  String        @id @default(uuid())
  tenantId            String?       @map("tenant_id")
  receptionistId      String        @map("receptionist_id")
  deskIdentifier      String        @map("desk_identifier")
  openedAt            DateTime      @default(now()) @map("opened_at")
  closedAt            DateTime?     @map("closed_at")
  openingCash         Decimal       @default(0.00) @map("opening_cash")
  actualCashCounted   Decimal?      @map("actual_cash_counted")
  expectedCash        Decimal?      @map("expected_cash")
  cashVariance        Decimal?      @map("cash_variance")
  status              ShiftStatus   @default(OPEN)
  closingNotes        String?       @map("closing_notes")

  tenant               Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receptionist         User          @relation(fields: [receptionistId], references: [id])
  attendances          Attendance[]
  disbursedSettlements SessionSettlement[]
  expenses             Expense[]
  auditLogs            AuditLog[]

  @@index([tenantId, receptionistId, status])
  @@index([tenantId])
  @@map("shift_registers")
}

// 7. Door Check-In & Payment Records
model Attendance {
  id                String            @id @default(uuid())
  tenantId          String?           @map("tenant_id")
  sessionId         String            @map("session_id")
  studentId         String            @map("student_id")
  receptionistId    String            @map("receptionist_id")
  shiftRegisterId   String            @map("shift_register_id")
  checkInTime       DateTime          @default(now()) @map("check_in_time")
  amountPaid        Decimal           @map("amount_paid")
  changeOwed        Decimal           @default(0.00) @map("change_owed")
  paymentMethod     PaymentMethod     @map("payment_method")
  paymentReference  String?           @map("payment_reference")
  status            AttendanceStatus  @default(PAID)

  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session           Session           @relation(fields: [sessionId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])
  receptionist      User              @relation(fields: [receptionistId], references: [id])
  shiftRegister     ShiftRegister     @relation(fields: [shiftRegisterId], references: [id])

  @@index([tenantId, sessionId, studentId])
  @@index([tenantId])
  @@index([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([shiftRegisterId, paymentMethod])
  @@map("attendances")
}

// 8. In-Hall Headcount Reconciliation
model SessionReconciliation {
  id                  String      @id @default(uuid())
  tenantId            String?     @map("tenant_id")
  sessionId           String      @unique @map("session_id")
  lobbyCount          Int         @map("lobby_count")
  assistantCount      Int         @map("assistant_count")
  discrepancy         Int
  reconciledHeadcount Int         @map("reconciled_headcount")
  resolutionNotes     String?     @map("resolution_notes")
  reconciledById      String      @map("reconciled_by")
  reconciledAt        DateTime    @default(now()) @map("reconciled_at")

  tenant              Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session             Session     @relation(fields: [sessionId], references: [id])
  reconciledBy        User        @relation(fields: [reconciledById], references: [id])
  settlement          SessionSettlement?

  @@index([tenantId])
  @@index([sessionId])
  @@map("session_reconciliations")
}

// 9. Session Financial Settlements (Teacher Payouts)
model SessionSettlement {
  id                    String            @id @default(uuid())
  tenantId              String?           @map("tenant_id")
  sessionId             String            @unique @map("session_id")
  reconciliationId      String            @unique @map("reconciliation_id")
  disbursedFromShiftId  String?           @map("disbursed_from_shift_id")
  reconciledHeadcount   Int               @map("reconciled_headcount")
  sessionPrice          Decimal           @map("session_price")
  centerFeePerStudent   Decimal           @map("center_fee_per_student")
  totalRevenue          Decimal           @map("total_revenue")
  centerRevenue         Decimal           @map("center_revenue")
  teacherPayout         Decimal           @map("teacher_payout")
  payoutMethod          PaymentMethod     @default(CASH) @map("payout_method")
  recipientName         String            @map("recipient_name")
  status                SettlementStatus  @default(DISBURSED)
  createdById           String            @map("created_by")
  settledAt             DateTime          @default(now()) @map("settled_at")

  tenant                Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session               Session           @relation(fields: [sessionId], references: [id])
  reconciliation        SessionReconciliation @relation(fields: [reconciliationId], references: [id])
  disbursedFromShift    ShiftRegister?    @relation(fields: [disbursedFromShiftId], references: [id])
  createdBy             User              @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([sessionId])
  @@index([disbursedFromShiftId])
  @@map("session_settlements")
}

// 10. Petty Cash & Desk Operating Expenses
model Expense {
  id                String        @id @default(uuid())
  tenantId          String?       @map("tenant_id")
  shiftRegisterId   String?       @map("shift_register_id")
  category          String
  amount            Decimal
  paymentMethod     PaymentMethod @default(CASH) @map("payment_method")
  description       String
  createdById       String        @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")

  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegister     ShiftRegister? @relation(fields: [shiftRegisterId], references: [id])
  createdBy         User          @relation(fields: [createdById], references: [id])

  @@index([tenantId, shiftRegisterId])
  @@index([tenantId])
  @@index([shiftRegisterId])
  @@map("expenses")
}

// 11. Operational Audit Trail
model AuditLog {
  id              String        @id @default(uuid())
  tenantId        String?       @map("tenant_id")
  shiftRegisterId String?       @map("shift_register_id")
  actorId         String        @map("actor_id")
  action          String
  entityType      String        @map("entity_type")
  entityId        String?       @map("entity_id")
  amount          Decimal?
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegister   ShiftRegister? @relation(fields: [shiftRegisterId], references: [id])
  actor           User           @relation(fields: [actorId], references: [id])

  @@index([tenantId, shiftRegisterId, createdAt])
  @@index([tenantId, createdAt])
  @@index([shiftRegisterId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
