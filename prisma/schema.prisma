generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionAdjustmentType {
  DISCOUNT
  CREDIT
  REFUND
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  VODAFONE_CASH
  INSTAPAY
}

enum AttendanceStatus {
  PAID
  PARTIAL
  EXCUSED
  VOID
}

enum SettlementStatus {
  PENDING
  DISBURSED
}

/// Optional capabilities a center can buy on top of the single Madar
/// subscription. An add-on is priced into the same invoice as the base
/// subscription; it is never a second product or a tier.
enum AddonCode {
  BOOKS_INVENTORY
}

/// Why a stock quantity changed. Every change to `branch_stocks.quantity`
/// must be explainable by one of these, so the on-hand figure is always
/// reconstructible from the movement ledger.
enum StockMovementType {
  /// Stock received from a supplier. Increases quantity.
  PURCHASE
  /// Items sold to a student. Decreases quantity.
  SALE
  /// Manual correction of a miscount. Signed by the recorded delta.
  ADJUSTMENT
  /// Damaged, lost or expired stock written off. Decreases quantity.
  WRITE_OFF
  /// Items returned to the shelf by a voided sale. Increases quantity.
  RETURN
}

/// Lifecycle of a recorded sale. A sale is a financial record: it is never
/// edited or deleted, only voided, and voiding writes a reversing movement.
enum SaleStatus {
  RECORDED
  VOIDED
}

enum SchoolType {
  GENERAL
  LANGUAGES
  AZHAR
}

// 0. SaaS Tenant (Educational Center)
model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  searchName  String?    @map("search_name")
  ownerName   String?    @map("owner_name")
  ownerPhone  String?    @map("owner_phone")
  trialEndsAt DateTime?  @map("trial_ends_at")
  isActive    Boolean    @default(true) @map("is_active")
  discountBalance Decimal @default(0) @map("discount_balance")
  creditBalance   Decimal @default(0) @map("credit_balance")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

   users                 User[]
   branches              Branch[]
   usageRecords          UsageRecord[]
   rooms                 Room[]
   teachers              Teacher[]
   students              Student[]
   sessions              Session[]
   shiftRegisters        ShiftRegister[]
   attendances           Attendance[]
  sessionReconciliations SessionReconciliation[]
  sessionSettlements     SessionSettlement[]
  expenses               Expense[]
  auditLogs              AuditLog[]
  subscriptions          Subscription[]
  SupportNote            SupportNote[]
  SuperAdminAuditLog     SuperAdminAuditLog[]
  SuperAdminSession      SuperAdminSession[]
  SystemHealthEvent      SystemHealthEvent[]
  SubscriptionAdjustment SubscriptionAdjustment[]
  addons                 TenantAddon[]
  products               Product[]
  branchStocks           BranchStock[]
  stockMovements         StockMovement[]
  bookSales              BookSale[]

  @@map("tenants")
}

// 0.1 SaaS Subscriptions & Billing
model Subscription {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  status           SubscriptionStatus @default(ACTIVE)
  amount           Decimal
  currency         String             @default("EGP")
  paymentMethod    PaymentMethod?     @map("payment_method")
  paymentReference String?            @map("payment_reference")
  periodStart      DateTime           @default(now()) @map("period_start")
  periodEnd        DateTime           @map("period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  adjustments SubscriptionAdjustment[]
  lineItems   SubscriptionLineItem[]

  @@index([tenantId])
  @@map("subscriptions")
}

/// The priced lines of one subscription period, frozen at the moment it was
/// invoiced: one BASE line plus one line per enabled add-on.
///
/// This is a snapshot, not a live view. A center that buys the Books & Inventory
/// add-on in March must still see a March invoice that says EGP 1,199, and a
/// February invoice that still says EGP 1,499 after they cancel in April — so
/// the prices and labels are copied here rather than read back from the current
/// price list. `subscriptions.amount` remains the authoritative total.
///
/// Rows are absent for periods invoiced before this table existed; readers
/// synthesize a single BASE line from `amount` in that case rather than showing
/// a broken invoice.
model SubscriptionLineItem {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  /// 'BASE' for the platform itself, or an AddonCode value.
  code           String
  labelEn        String       @map("label_en")
  labelAr        String       @map("label_ar")
  amount         Decimal
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_line_items")
}

// 0.2 SaaS Tenant Branches
model Branch {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  name                  String
  address               String?
  phoneNumber           String?                @map("phone_number")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecords          UsageRecord[]
  rooms                 Room[]
  branchStocks          BranchStock[]
  stockMovements        StockMovement[]
  bookSales             BookSale[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// 0.3 Monthly Usage Records
model UsageRecord {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  branchId              String?                @map("branch_id")
  periodStart           DateTime               @map("period_start")
  periodEnd             DateTime               @map("period_end")
  visitCount            Int                    @default(0) @map("visit_count")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, periodStart, periodEnd])
  @@index([tenantId, periodStart, periodEnd])
  @@map("usage_records")
}

// ─── Books & Inventory add-on ───────────────────────────────────────────────
//
// Everything below is only reachable by a center that has paid for the
// BOOKS_INVENTORY add-on (see `TenantAddon`). The gate is enforced in the route
// module, not here: these tables stay in the same schema so that enabling the
// add-on never requires a migration.

// Which optional capabilities a center has bought. An enabled add-on is priced
// into every subsequent invoice; disabling one stops the next invoice, and
// never touches a period that has already been paid for.
model TenantAddon {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  code         AddonCode
  enabled      Boolean    @default(true)
  enabledAt    DateTime   @default(now()) @map("enabled_at")
  disabledAt   DateTime?  @map("disabled_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tenant_addons")
}

/// A book or supply the center stocks. `salePrice` is what a student pays and
/// `costPrice` is what the center paid; both are copied onto the sale line at
/// the moment of sale so that editing a product later cannot rewrite the
/// center's historical revenue or profit.
model Product {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  nameAr        String    @map("name_ar")
  nameEn        String?   @map("name_en")
  /// Normalized Arabic name for trigram search, mirroring `Student.searchName`.
  searchName    String    @map("search_name")
  sku           String?
  categoryAr    String?   @map("category_ar")
  salePrice     Decimal   @map("sale_price")
  costPrice     Decimal   @default(0) @map("cost_price")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchStocks  BranchStock[]
  movements     StockMovement[]
  saleLines     BookSaleLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, searchName])
  @@index([tenantId, isActive])
  @@map("products")
}

/// On-hand quantity for one product at one branch. Stock is per branch because
/// two branches are two physical shelves; a single pooled figure would let one
/// site sell what another site owns.
model BranchStock {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  branchId      String   @map("branch_id")
  productId     String   @map("product_id")
  quantity      Int      @default(0)
  /// Quantity at or below which the branch should reorder. 0 disables the alert.
  reorderLevel  Int      @default(0) @map("reorder_level")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId, branchId])
  @@map("branch_stocks")
}

/// The append-only ledger of every quantity change. `branch_stocks.quantity` is
/// a cached running total of these rows, never an independently edited number,
/// so the on-hand figure can always be re-derived and audited.
model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  branchId      String            @map("branch_id")
  productId     String            @map("product_id")
  type          StockMovementType
  /// Always positive. The direction of the change is implied by `type`, except
  /// for ADJUSTMENT where the sign of the applied delta is recorded in `delta`.
  quantity      Int
  /// Signed change actually applied to the on-hand quantity. Equal to `quantity`
  /// for every type except ADJUSTMENT.
  delta         Int
  /// What one unit cost the center, captured from the product at the time.
  unitCost      Decimal?          @map("unit_cost")
  note          String?
  saleId        String?           @map("sale_id")
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale          BookSale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, productId])
  @@index([tenantId, createdAt])
  @@index([saleId])
  @@map("stock_movements")
}

/// A sale of books/supplies to a student. This is a financial record, so it is
/// immutable once written: correcting a mistake means voiding it and recording a
/// replacement, never editing the totals. `total`/`costTotal` are snapshots of
/// the line maths at the moment of sale.
model BookSale {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  studentId       String        @map("student_id")
  status          SaleStatus    @default(RECORDED)
  /// What the student paid, summed from the lines.
  total           Decimal
  /// What those same items cost the center, so profit stays reportable even
  /// after a product's costPrice is edited.
  costTotal       Decimal       @map("cost_total")
  paymentMethod   PaymentMethod @map("payment_method")
  /// The open shift this cash should be found in at reconciliation. Nullable so
  /// a sale recorded outside a desk register still has somewhere to go.
  shiftRegisterId String?       @map("shift_register_id")
  voidedAt        DateTime?     @map("voided_at")
  voidReason      String?       @map("void_reason")
  note            String?
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  shiftRegister   ShiftRegister? @relation(fields: [shiftRegisterId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lines           BookSaleLine[]
  movements       StockMovement[]

  @@index([tenantId, createdAt])
  @@index([tenantId, studentId])
  @@index([tenantId, branchId])
  @@index([shiftRegisterId])
  @@map("book_sales")
}

/// One product on one sale, with the prices frozen at sale time.
model BookSaleLine {
  id            String    @id @default(uuid())
  saleId        String    @map("sale_id")
  productId     String    @map("product_id")
  quantity      Int
  unitPrice     Decimal   @map("unit_price")
  unitCost      Decimal   @map("unit_cost")
  lineTotal     Decimal   @map("line_total")

  sale          BookSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("book_sale_lines")
}

// 1. Center Staff Internal Accounts
model User {
  id                String   @id @default(uuid())
  tenantId          String?  @map("tenant_id")
  username          String   @unique
  email             String?  @unique
  passwordHash      String   @map("password_hash")
  fullName          String   @map("full_name")
  searchName        String?  @map("search_name")
  role              Role     @default(RECEPTIONIST)
  phoneNumber       String?  @map("phone_number")
  preferredLanguage String   @default("ar") @map("preferred_language")
  isActive          Boolean  @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant                    Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegisters            ShiftRegister[]
  attendances               Attendance[]
  reconciliations           SessionReconciliation[]
  settlements               SessionSettlement[]
  expenses                  Expense[]
  sessionsCreated           Session[]
  auditLogs                 AuditLog[]
  supportNotesAuthored      SupportNote[]
  platformNotifications     PlatformNotification[]
  superAdminAuditLogs       SuperAdminAuditLog[]
  systemSettingsUpdated     SystemSetting[]
  superAdminSessions        SuperAdminSession[]
  superAdminUserPermissions SuperAdminUserPermission[]
  subscriptionAdjustments    SubscriptionAdjustment[]
  stockMovements            StockMovement[]
  bookSales                 BookSale[]

  @@index([tenantId])
  @@map("users")
}

// 2. Classrooms & Lecture Halls
model Room {
   id        String   @id @default(uuid())
   tenantId  String?  @map("tenant_id")
   branchId  String?  @map("branch_id")
  name      String
  capacity  Int
  floor     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

   tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
   branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
   sessions  Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([branchId])
  @@map("rooms")
}

// 3. Tutors / Instructors
model Teacher {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id")
  fullName         String   @map("full_name")
  /// Normalized Arabic name for trigram search
  searchName       String   @map("search_name")
  phoneNumber      String   @map("phone_number")
  subject          String
  defaultCenterFee Decimal  @map("default_center_fee")
  assistantName    String?  @map("assistant_name")
  assistantPhone   String?  @map("assistant_phone")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([tenantId, searchName])
  @@index([tenantId])
  @@map("teachers")
}

// 4. Student Master Directory
model Student {
  id            String     @id @default(uuid())
  tenantId      String?    @map("tenant_id")
  studentCode   String     @map("student_code")
  fullName      String     @map("full_name")
  /// Normalized Arabic name (Alef unified, taa marbouta, diacritics stripped) for trigram search
  searchName    String     @map("search_name")
  studentPhone  String?    @map("student_phone")
  guardianPhone String     @map("guardian_phone")
  academicStage String     @map("academic_stage")
  schoolType    SchoolType @default(GENERAL) @map("school_type")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  bookSales   BookSale[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, searchName])
  @@index([tenantId, studentPhone])
  @@index([tenantId, guardianPhone])
  @@index([tenantId])
  @@map("students")
}

// 5. Scheduled Class Sessions
model Session {
  id                  String        @id @default(uuid())
  tenantId            String?       @map("tenant_id")
  teacherId           String        @map("teacher_id")
  roomId              String        @map("room_id")
  title               String
  academicStage       String        @map("academic_stage")
  startTime           DateTime      @map("start_time")
  endTime             DateTime      @map("end_time")
  sessionPrice        Decimal       @map("session_price")
  centerFeePerStudent Decimal       @map("center_fee_per_student")
  status              SessionStatus @default(SCHEDULED)
  createdById         String        @map("created_by")
  createdAt           DateTime      @default(now()) @map("created_at")

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  room      Room    @relation(fields: [roomId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  attendances    Attendance[]
  reconciliation SessionReconciliation?
  settlement     SessionSettlement?

  @@index([tenantId, status, startTime, endTime])
  @@index([tenantId])
  @@index([teacherId])
  @@index([roomId])
  @@map("sessions")
}

// 6. Per-Desk Shift Cash Drawers
model ShiftRegister {
  id                String      @id @default(uuid())
  tenantId          String?     @map("tenant_id")
  receptionistId    String      @map("receptionist_id")
  deskIdentifier    String      @map("desk_identifier")
  openedAt          DateTime    @default(now()) @map("opened_at")
  closedAt          DateTime?   @map("closed_at")
  openingCash       Decimal     @default(0.00) @map("opening_cash")
  actualCashCounted Decimal?    @map("actual_cash_counted")
  expectedCash      Decimal?    @map("expected_cash")
  cashVariance      Decimal?    @map("cash_variance")
  status            ShiftStatus @default(OPEN)
  closingNotes      String?     @map("closing_notes")

  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receptionist         User                @relation(fields: [receptionistId], references: [id])
  attendances          Attendance[]
  disbursedSettlements SessionSettlement[]
  expenses             Expense[]
  bookSales            BookSale[]
  auditLogs            AuditLog[]

  @@index([tenantId, receptionistId, status])
  @@index([tenantId])
  @@map("shift_registers")
}

// 7. Door Check-In & Payment Records
model Attendance {
  id               String           @id @default(uuid())
  tenantId         String?          @map("tenant_id")
  sessionId        String           @map("session_id")
  studentId        String           @map("student_id")
  receptionistId   String           @map("receptionist_id")
  shiftRegisterId  String           @map("shift_register_id")
  checkInTime      DateTime         @default(now()) @map("check_in_time")
  amountPaid       Decimal          @map("amount_paid")
  changeOwed       Decimal          @default(0.00) @map("change_owed")
  paymentMethod    PaymentMethod    @map("payment_method")
  paymentReference String?          @map("payment_reference")
  status           AttendanceStatus @default(PAID)

  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session       Session       @relation(fields: [sessionId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  receptionist  User          @relation(fields: [receptionistId], references: [id])
  shiftRegister ShiftRegister @relation(fields: [shiftRegisterId], references: [id])

  @@index([tenantId, sessionId, studentId])
  @@index([tenantId])
  @@index([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([shiftRegisterId, paymentMethod])
  @@map("attendances")
}

// 8. In-Hall Headcount Reconciliation
model SessionReconciliation {
  id                  String   @id @default(uuid())
  tenantId            String?  @map("tenant_id")
  sessionId           String   @unique @map("session_id")
  lobbyCount          Int      @map("lobby_count")
  assistantCount      Int      @map("assistant_count")
  discrepancy         Int
  reconciledHeadcount Int      @map("reconciled_headcount")
  resolutionNotes     String?  @map("resolution_notes")
  reconciledById      String   @map("reconciled_by")
  reconciledAt        DateTime @default(now()) @map("reconciled_at")

  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      Session            @relation(fields: [sessionId], references: [id])
  reconciledBy User               @relation(fields: [reconciledById], references: [id])
  settlement   SessionSettlement?

  @@index([tenantId])
  @@index([sessionId])
  @@map("session_reconciliations")
}

// 9. Session Financial Settlements (Teacher Payouts)
model SessionSettlement {
  id                   String           @id @default(uuid())
  tenantId             String?          @map("tenant_id")
  sessionId            String           @unique @map("session_id")
  reconciliationId     String           @unique @map("reconciliation_id")
  disbursedFromShiftId String?          @map("disbursed_from_shift_id")
  reconciledHeadcount  Int              @map("reconciled_headcount")
  sessionPrice         Decimal          @map("session_price")
  centerFeePerStudent  Decimal          @map("center_fee_per_student")
  totalRevenue         Decimal          @map("total_revenue")
  centerRevenue        Decimal          @map("center_revenue")
  teacherPayout        Decimal          @map("teacher_payout")
  payoutMethod         PaymentMethod    @default(CASH) @map("payout_method")
  recipientName        String           @map("recipient_name")
  status               SettlementStatus @default(DISBURSED)
  createdById          String           @map("created_by")
  settledAt            DateTime         @default(now()) @map("settled_at")

  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session            Session               @relation(fields: [sessionId], references: [id])
  reconciliation     SessionReconciliation @relation(fields: [reconciliationId], references: [id])
  disbursedFromShift ShiftRegister?        @relation(fields: [disbursedFromShiftId], references: [id])
  createdBy          User                  @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([sessionId])
  @@index([disbursedFromShiftId])
  @@map("session_settlements")
}

// 10. Petty Cash & Desk Operating Expenses
model Expense {
  id              String        @id @default(uuid())
  tenantId        String?       @map("tenant_id")
  shiftRegisterId String?       @map("shift_register_id")
  category        String
  amount          Decimal
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  description     String
  createdById     String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegister ShiftRegister? @relation(fields: [shiftRegisterId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])

  @@index([tenantId, shiftRegisterId])
  @@index([tenantId])
  @@index([shiftRegisterId])
  @@map("expenses")
}

// 11. Operational Audit Trail
model AuditLog {
  id              String   @id @default(uuid())
  tenantId        String?  @map("tenant_id")
  shiftRegisterId String?  @map("shift_register_id")
  actorId         String   @map("actor_id")
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  amount          Decimal?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftRegister ShiftRegister? @relation(fields: [shiftRegisterId], references: [id])
  actor         User           @relation(fields: [actorId], references: [id])

  @@index([tenantId, shiftRegisterId, createdAt])
  @@index([tenantId, createdAt])
  @@index([shiftRegisterId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Platform (Super Admin) — additive models, tenant-scoped
// ============================================================

enum SupportNoteStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PlatformNotificationAudience {
  ALL_CENTERS
  CENTER
  USER
}

enum PlatformNotificationStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ARCHIVED
}

enum SystemHealthLevel {
  INFO
  WARNING
  CRITICAL
}

model SupportNote {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  authorId  String            @map("author_id")
  text      String
  status    SupportNoteStatus @default(OPEN)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([authorId])
  @@index([status])
  @@map("support_notes")
}

model PlatformNotification {
  id          String                       @id @default(uuid())
  titleAr     String                       @map("title_ar")
  bodyAr      String                       @map("body_ar")
  audience    PlatformNotificationAudience
  audienceIds String[]                     @map("audience_ids")
  status      PlatformNotificationStatus   @default(DRAFT)
  scheduledAt DateTime?                    @map("scheduled_at")
  sentAt      DateTime?                    @map("sent_at")
  createdById String                       @map("created_by_id")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([audience])
  @@index([status])
  @@index([createdById])
  @@map("platform_notifications")
}

model SuperAdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  tenantId   String?  @map("tenant_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User    @relation(fields: [actorId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@map("super_admin_audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model SubscriptionAdjustment {
  id             String                   @id @default(uuid())
  tenantId       String                   @map("tenant_id")
  subscriptionId String?                  @map("subscription_id")
  type           SubscriptionAdjustmentType
  amount         Decimal
  reason         String?
  createdById    String                   @map("created_by_id")
  createdAt      DateTime                 @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([type])
  @@map("subscription_adjustments")
}

model SuperAdminSession {
  id                    String    @id @default(uuid())
  adminUserId           String    @map("admin_user_id")
  impersonatingTenantId String?   @map("impersonating_tenant_id")
  reason                String?
  startedAt             DateTime  @default(now()) @map("started_at")
  expiresAt             DateTime? @map("expires_at")
  endedAt               DateTime? @map("ended_at")

  adminUser           User    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  impersonatingTenant Tenant? @relation(fields: [impersonatingTenantId], references: [id])

  @@index([adminUserId])
  @@index([impersonatingTenantId])
  @@map("super_admin_sessions")
}

model SystemHealthEvent {
  id         String            @id @default(uuid())
  level      SystemHealthLevel
  category   String
  message    String
  tenantId   String?           @map("tenant_id")
  meta       Json?
  resolvedAt DateTime?         @map("resolved_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([category])
  @@index([tenantId])
  @@map("system_health_events")
}

model SuperAdminPermission {
  id                       String                     @id @default(uuid())
  key                      String                     @unique
  descriptionAr            String?                    @map("description_ar")
  createdAt                DateTime                   @default(now()) @map("created_at")
  SuperAdminUserPermission SuperAdminUserPermission[]

  @@map("super_admin_permissions")
}

model SuperAdminUserPermission {
  id           String   @id @default(uuid())
  adminUserId  String   @map("admin_user_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")

  adminUser  User                 @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission SuperAdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permissionId])
  @@map("super_admin_user_permissions")
}
