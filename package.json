{
  "name": "educational-center-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Educational Center ERP for Egyptian Tutoring Centers - Arabic-First & RTL Native",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/server.ts",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:production": "npm run db:generate && npm run build:client && npm run build:server",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/server.js",
    "start:production": "prisma migrate deploy && node dist/server/server/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/postgres.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/postgres.ps1 stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/postgres.ps1 status",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1 backup",
    "db:backups:list": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1 list",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1 restore -Confirm",
    "db:backup:remote": "node scripts/backup/runBackup.mjs",
    "db:backups:remote:list": "node scripts/backup/runBackup.mjs --list",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/db/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/integration/db/*.test.ts",
    "test:db:setup": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 setup",
    "test:db:reset": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 reset",
    "test:frontend": "vitest run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.40.3",
    "fastify": "^4.28.1",
    "i18next": "^23.14.0",
    "lucide-react": "^0.439.0",
    "prisma": "^5.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
